generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Plan {
  FREE
  PRO
}

enum Role {
  USER
  ADMIN
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  name         String
  passwordHash String
  plan         Plan          @default(FREE)
  role         Role          @default(USER)
  /// Set when an administrator closes the account. Login and existing sessions stop working.
  disabledAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  qrCodes      QrCode[]
  subscription Subscription?
  pageViews    PageView[]

  @@index([plan])
  @@index([createdAt])
}

/// A link turned into a styled QR code.
model QrCode {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  destination String
  /// Dynamic codes encode /r/{code} and redirect, so the destination can change after printing.
  dynamic     Boolean  @default(false)
  /// Short code used in /r/{code}.
  code        String   @unique
  /// QrStyle (see src/lib/qr-style.ts).
  style       Json
  scans       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  scanEvents  QrScan[]

  @@index([userId, updatedAt(sort: Desc)])
}

model QrScan {
  id        String   @id @default(cuid())
  qrCodeId  String
  qrCode    QrCode   @relation(fields: [qrCodeId], references: [id], onDelete: Cascade)
  /// ios | android | desktop | other
  device    String   @default("other")
  country   String?
  city      String?
  createdAt DateTime @default(now())

  @@index([qrCodeId, createdAt(sort: Desc)])
}

/// Commercial state of an account. `User.plan` remains what the product enforces.
model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status             SubscriptionStatus @default(NONE)
  /// Monthly price in euro cents. Revenue on the admin desk sums active rows.
  priceCents         Int                @default(0)
  currency           String             @default("EUR")
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  notes              String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([status])
}

/// A view of a public page. `ip` is personal data and is visible only in the admin space.
model PageView {
  id        String   @id @default(cuid())
  /// Path without the locale prefix, e.g. `/studio`.
  path      String
  locale    String?
  /// Origin and path only. Query strings are dropped.
  referrer  String?
  ip        String
  userAgent String?
  /// ios | android | desktop | other
  device    String   @default("other")
  bot       Boolean  @default(false)
  country   String?
  city      String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([bot, createdAt(sort: Desc)])
  @@index([ip, createdAt(sort: Desc)])
  @@index([path, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}
